# 模型端点 (OpenAI 兼容)：可填 OpenAI，或国内闭源/开源网关
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-xxxx
# LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:7b
# # ollama 不校验 key，占位即可
LLM_API_KEY=ollama
# Embedding 模型 (同一端点下 /embeddings, 用于长期记忆语义检索/去重)
# 注: 需要 ollama 里 pull 一个 embedding 模型(如 `ollama pull nomic-embed-text`)才生效,
# 否则自动降级为哈希向量(仍能跑, 只是语义检索不准)
EMBEDDING_MODEL=nomic-embed-text

# 长期记忆向量存储路径
MEMORY_DB_PATH=./data/memory.db
# 长期记忆容量(超量触发 LRU 遗忘)
MEMORY_CAPACITY=200